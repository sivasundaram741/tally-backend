# Copy to .env and fill in. Never commit the real file.
PORT=4000

# SQL Server. For a named instance (SERVER\INSTANCE) split it across HOST and
# INSTANCE; the SQL Browser service must be running, or set SQLSERVER_PORT.
SQLSERVER_HOST=YOUR-MACHINE
SQLSERVER_INSTANCE=SQLEXPRESS
# SQLSERVER_PORT=1433
SQLSERVER_DATABASE=LedgerTrail
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=true
