# Copy to .env and fill in. Never commit the real file.
PORT=4000
# Product name in messages and /api/health (display only - the database name
# and backup format keep their original identifiers).
APP_NAME=Catchu Ledger Trail

# MongoDB. A local server is usually mongodb://127.0.0.1:27017 (prefer
# 127.0.0.1 to localhost: mongod listens on IPv4 by default). For a server
# with authentication use mongodb://user:password@host:27017/?authSource=admin
# or a mongodb+srv:// Atlas string. The database and its collections are
# created on first run.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=LedgerTrail

# Optional: the old SQL Server database, read only by
# `npm run migrate-from-sqlserver`. Remove once the migration is done.
# For a named instance (SERVER\INSTANCE) split it across HOST and INSTANCE;
# the SQL Browser service must be running, or set SQLSERVER_PORT. On the same
# machine use localhost, not the machine name.
SQLSERVER_HOST=localhost
SQLSERVER_INSTANCE=SQLEXPRESS
# SQLSERVER_PORT=1433
SQLSERVER_DATABASE=LedgerTrail
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=true
