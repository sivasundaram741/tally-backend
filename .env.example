# Copy to .env and fill in. Never commit the real file.
PORT=4000
# Product name in messages and /api/health (display only - the database name
# and backup format keep their original identifiers).
APP_NAME=Catchu Ledger Trail

# SQL Server. For a named instance (SERVER\INSTANCE) split it across HOST and
# INSTANCE; the SQL Browser service must be running, or set SQLSERVER_PORT.
# When SQL Server is on this same machine use localhost: the machine name can
# resolve to an IPv6 link-local address first, and connections then time out.
SQLSERVER_HOST=localhost
SQLSERVER_INSTANCE=SQLEXPRESS
# SQLSERVER_PORT=1433
SQLSERVER_DATABASE=LedgerTrail
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_CERT=true
